[Unit]
Description=Claudex durable error recovery (t3 T3 Code, approval-safe)
Documentation=file:%h/.local/share/claudex/recovery/README.md
After=t3code.service
Wants=t3code.service
ConditionPathExists=%h/.local/state/claudex-recovery/config.json

[Service]
Type=oneshot
WorkingDirectory=%h
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=%h/.local/share/claudex/recovery/run-controller.sh --once --live
UMask=0077
TimeoutStartSec=45
MemoryMax=512M
CPUQuota=50%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/state/claudex-recovery %h/.t3/userdata

[Install]
WantedBy=default.target
