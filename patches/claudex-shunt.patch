+#[test]
+fn parallel_indexed_calls_with_final_only_arguments_keep_each_tool_input() {
+    // Captured GPT-6 Astra SSE: both function calls carry their complete JSON
+    // in `.arguments.done`/`output_item.done` without a single args delta.
+    // Interleaved, reverse completion order must not mix or drop call inputs.
+    let event = |kind: &str, data| ResponseEvent {
+        event: Some(kind.to_string()), data,
+    };
+    let mut machine = AnthropicSseMachine::new("gpt-6-astra", false, false);
+    let events = vec![
+        event("response.created", json!({"response":{"id":"resp_parallel"}})),
+        event("response.output_item.added", json!({"output_index":0,
+            "item":{"type":"function_call","call_id":"call_alpha","name":"lookup_number","arguments":""}})),
+        event("response.output_item.added", json!({"output_index":1,
+            "item":{"type":"function_call","call_id":"call_beta","name":"lookup_number","arguments":""}})),
+        event("response.function_call_arguments.done", json!({"output_index":1,"arguments":"{\"key\":\"beta\"}"})),
+        event("response.function_call_arguments.done", json!({"output_index":0,"arguments":"{\"key\":\"alpha\"}"})),
+        event("response.output_item.done", json!({"output_index":1,
+            "item":{"type":"function_call","call_id":"call_beta","name":"lookup_number","arguments":"{\"key\":\"beta\"}"}})),
+        event("response.output_item.done", json!({"output_index":0,
+            "item":{"type":"function_call","call_id":"call_alpha","name":"lookup_number","arguments":"{\"key\":\"alpha\"}"}})),
+        event("response.completed", json!({"response":{"usage":{"input_tokens":10,"output_tokens":20}}})),
+    ];
+    let emitted = events.into_iter()
+        .flat_map(|e| machine.apply(e)).collect::<String>();
+    let blocks = machine.final_json()["content"].as_array().unwrap().clone();
+    assert_eq!(blocks.len(), 2);
+    assert_eq!(blocks[0]["id"], "call_beta");
+    assert_eq!(blocks[0]["input"], json!({"key":"beta"}));
+    assert_eq!(blocks[1]["id"], "call_alpha");
+    assert_eq!(blocks[1]["input"], json!({"key":"alpha"}));
+    let deltas: Vec<_> = emitted.lines()
+        .filter_map(|line| line.strip_prefix("data: "))
+        .filter_map(|line| serde_json::from_str::<Value>(line).ok())
+        .filter_map(|e| e.pointer("/delta/partial_json").and_then(Value::as_str).map(str::to_string))
+        .collect();
+    assert_eq!(deltas, vec!["{\"key\":\"beta\"}", "{\"key\":\"alpha\"}"]);
+
+    // Both tool results must round-trip as distinct function_call_output items.
+    let request = translate(json!({"messages":[
+        {"role":"assistant", "content":blocks},
+        {"role":"user", "content":[
+            {"type":"tool_result", "tool_use_id":"call_alpha", "content":"11"},
+            {"type":"tool_result", "tool_use_id":"call_beta", "content":"22"}
+        ]}
+    ]}));
+    let items=request["input"].as_array().unwrap();
+    assert_eq!(items.len(), 4);
+    assert_eq!(items[0]["call_id"], "call_beta");
+    assert_eq!(items[1]["call_id"], "call_alpha");
+    assert_eq!(items[2]["call_id"], "call_alpha");
+    assert_eq!(items[3]["call_id"], "call_beta");
+}
