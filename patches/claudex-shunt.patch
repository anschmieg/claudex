+#[test]
+fn claudex_replays_web_search_open_page_action_losslessly() {
+    let request = json!({
+        "model": "gpt-6.1-sol",
+        "messages": [{
+            "role": "assistant",
+            "content": [
+                {
+                    "type": "server_tool_use",
+                    "id": "ws_open",
+                    "name": "web_search",
+                    "input": {"type": "open_page", "url": "https://openai.com/news/"}
+                },
+                {
+                    "type": "web_search_tool_result",
+                    "tool_use_id": "ws_open",
+                    "content": [{
+                        "type": "text_result",
+                        "url": "https://openai.com/news/",
+                        "title": "OpenAI News",
+                        "snippet": "Recent news"
+                    }]
+                }
+            ]
+        }],
+        "tools": [{"type": "web_search_20250305", "name": "web_search"}]
+    });
+    let body = serde_json::to_vec(&request).unwrap();
+    let actual = translate_request(
+        &body,
+        &route("gpt-6.1-sol"),
+        ResponsesFlavor::Chatgpt,
+        false,
+        None,
+        true,
+    )
+    .unwrap();
+
+    assert_eq!(actual["input"][0]["type"], "web_search_call");
+    assert_eq!(actual["input"][0]["status"], "completed");
+    assert_eq!(
+        actual["input"][0]["action"],
+        json!({"type": "open_page", "url": "https://openai.com/news/"})
+    );
+}
