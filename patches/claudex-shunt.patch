+#[test]
+fn claudex_drops_model_bound_reasoning_after_model_switch() {
+    let signature = shunt::model::responses::encode_reasoning_signature_for_model(
+        "rs_1",
+        "ENC123",
+        "gpt-6.1-sol",
+    );
+    let request = json!({
+        "thinking": {"type": "enabled"},
+        "messages": [
+            {"role": "user", "content": "hi"},
+            {"role": "assistant", "content": [
+                {"type": "thinking", "thinking": "old state", "signature": signature},
+                {"type": "text", "text": "Hi"}
+            ]}
+        ]
+    });
+    let body = serde_json::to_vec(&request).unwrap();
+    let actual = translate_request(
+        &body,
+        &route("gpt-6-astra"),
+        ResponsesFlavor::Chatgpt,
+        false,
+        None,
+        true,
+    )
+    .unwrap();
+
+    assert!(actual["input"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .all(|item| item["type"] != "reasoning"));
+}
