+        "model": "gpt-6.1-sol",
+        "messages": [
+            {
+                "role": "assistant",
+                "content": [
+                    {
+                        "type": "server_tool_use",
+                        "id": "ws_1",
+                        "name": "web_search",
+                        "input": {"query": "Rust language"}
+                    },
+                    {
+                        "type": "web_search_tool_result",
+                        "tool_use_id": "ws_1",
+                        "content": [
+                            {
+                                "type": "web_search_result",
+                                "url": "https://www.rust-lang.org/",
+                                "title": "Rust",
+                                "encrypted_content": "enc"
+                            }
+                        ]
+                    },
+                    {
+                        "type": "text",
+                        "text": "Rust is a systems language.",
+                        "citations": [
+                            {
+                                "type": "web_search_result_location",
+                                "url": "https://www.rust-lang.org/",
+                                "title": "Rust",
+                                "cited_text": "Rust is a systems language.",
+                                "encrypted_index": "enc-index"
+                            }
+                        ]
+                    }
+                ]
+            },
+            {"role": "user", "content": "Tell me more."}
+        ],
+        "tools": [
+            {"type": "web_search_20250305", "name": "web_search", "max_uses": 8}
+        ]
+    });
+    let body = serde_json::to_vec(&request).unwrap();
+    let actual = translate_request(
+        &body,
+        &route("gpt-6.1-sol"),
+        ResponsesFlavor::Chatgpt,
+        false,
+        None,
+        true,
+    )
+    .unwrap();
+
+    let include = actual["include"].as_array().unwrap();
+    assert!(include.iter().any(|v| v == "web_search_call.results"));
+    assert_eq!(actual["input"][0]["type"], "web_search_call");
+    assert_eq!(actual["input"][0]["status"], "completed");
+    assert_eq!(actual["input"][0]["action"]["query"], "Rust language");
+    assert_eq!(actual["input"][0]["results"][0]["url"], "https://www.rust-lang.org/");
+    assert_eq!(actual["input"][0]["results"][0]["encrypted_content"], "enc");
+    assert_eq!(actual["input"][1]["role"], "assistant");
+    assert_eq!(
+        actual["input"][1]["content"][0]["annotations"][0]["type"],
+        "url_citation"
+    );
+    assert_eq!(
+        actual["input"][1]["content"][0]["annotations"][0]["start_index"],
+        0
+    );
+    assert_eq!(
+        actual["input"][1]["content"][0]["annotations"][0]["end_index"],
+        27
+    );
+}
